{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dualtranslation.local/schemas/conversion-request.schema.json",
  "title": "ConversionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "input",
    "targetAgent",
    "languagePreference",
    "generationMode",
    "clarificationAnswers",
    "projectContexts",
    "providerProfileId",
    "saveToHistory",
    "allowSensitiveHistory"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["write", "explain"] },
    "input": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "targetAgent": { "enum": ["generic", "cursor", "codex"] },
    "languagePreference": { "enum": ["auto", "zh", "en", "bilingual"] },
    "generationMode": { "enum": ["quick", "negotiated"] },
    "clarificationAnswers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "question", "reason", "answer"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "reason": { "type": "string", "maxLength": 4000 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "projectContexts": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "projectName",
          "technologies",
          "facts",
          "files",
          "scannedFileCount",
          "ignoredFileCount",
          "redactedFindings",
          "fingerprint",
          "scannedAt"
        ],
        "properties": {
          "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "projectName": { "type": "string", "minLength": 1, "maxLength": 200 },
          "technologies": { "$ref": "#/$defs/stringList" },
          "facts": { "$ref": "#/$defs/stringList" },
          "files": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason", "excerpt", "truncated", "redactedFindings"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "excerpt": { "type": "string", "maxLength": 6000 },
                "truncated": { "type": "boolean" },
                "redactedFindings": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "scannedFileCount": { "type": "integer", "minimum": 0 },
          "ignoredFileCount": { "type": "integer", "minimum": 0 },
          "redactedFindings": { "type": "integer", "minimum": 0 },
          "fingerprint": { "type": "string", "maxLength": 128 },
          "scannedAt": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "providerProfileId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "saveToHistory": { "type": "boolean" },
    "allowSensitiveHistory": { "type": "boolean" }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
