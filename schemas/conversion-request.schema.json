{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dualtranslation.local/schemas/conversion-request.schema.json",
  "title": "ConversionRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "input",
    "targetAgent",
    "languagePreference",
    "generationMode",
    "clarificationAnswers",
    "providerProfileId",
    "saveToHistory",
    "allowSensitiveHistory"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["write", "explain"] },
    "input": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "targetAgent": { "enum": ["generic", "cursor", "codex"] },
    "languagePreference": { "enum": ["auto", "zh", "en", "bilingual"] },
    "generationMode": { "enum": ["quick", "negotiated"] },
    "clarificationAnswers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "answer"],
        "properties": {
          "questionId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "providerProfileId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "saveToHistory": { "type": "boolean" },
    "allowSensitiveHistory": { "type": "boolean" }
  }
}
