{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dualtranslation.local/schemas/canonical-task-spec.schema.json",
  "title": "CanonicalTaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "type",
    "goal",
    "motivation",
    "context",
    "scope",
    "constraints",
    "assumptions",
    "unknowns",
    "agentBehavior",
    "acceptanceCriteria",
    "verification",
    "deliverables",
    "outputLanguage",
    "targetAgent"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "type": {
      "enum": ["feature", "bugfix", "ui", "refactor", "review", "research"]
    },
    "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "motivation": { "type": ["string", "null"], "maxLength": 2000 },
    "context": { "$ref": "#/$defs/stringList" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope", "outOfScope"],
      "properties": {
        "inScope": { "$ref": "#/$defs/stringList" },
        "outOfScope": { "$ref": "#/$defs/stringList" }
      }
    },
    "constraints": { "$ref": "#/$defs/stringList" },
    "assumptions": { "$ref": "#/$defs/stringList" },
    "unknowns": { "$ref": "#/$defs/stringList" },
    "agentBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspectBeforeAction", "planBeforeAction", "confirmationRequiredFor"],
      "properties": {
        "inspectBeforeAction": { "type": "boolean" },
        "planBeforeAction": { "type": "boolean" },
        "confirmationRequiredFor": { "$ref": "#/$defs/stringList" }
      }
    },
    "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStringList" },
    "verification": { "$ref": "#/$defs/stringList" },
    "deliverables": { "$ref": "#/$defs/nonEmptyStringList" },
    "outputLanguage": { "enum": ["zh", "en", "bilingual"] },
    "targetAgent": { "enum": ["generic", "cursor", "codex"] }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "maxItems": 100,
      "uniqueItems": true
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "maxItems": 100,
      "uniqueItems": true
    }
  }
}
