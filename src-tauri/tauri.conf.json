{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DualTranslation",
  "version": "0.2.0",
  "identifier": "com.dualtranslation.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DualTranslation · 二元编译",
        "width": 820,
        "height": 520,
        "minWidth": 600,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "在人类与 Coding Agent 之间完成双向语义转换",
    "longDescription": "DualTranslation 将模糊想法整理成可执行提示词，并将 Coding Agent 回复解释为易懂说明。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
